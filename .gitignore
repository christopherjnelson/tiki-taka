# Dependencies and local tooling
node_modules/
.tooling/

# Build and package output
dist/
release/
public/downloads/
apps/mobile/www/
apps/mobile/android/.gradle/
apps/mobile/android/**/build/

# Test output
test-results/
coverage/
.playwright/
playwright-report/
tests/.tmp-*

# Machine-local Android configuration and signing material
apps/mobile/android/local.properties
*.jks
*.keystore
*.key
*.p12
*.pem

# Environment files and logs
.env
.env.*
!.env.example
*.log
npm-debug.log*

# Editor and operating-system metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Local server database (root only — an unanchored `data/` also swallowed
# packages/data/, hiding tracked source from git)
/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Soundtrack .ogg files: fetched at runtime from a manifest instead of being
# built and shipped (apps/desktop/src/manifest.js, public/audio/manifest.json).
# Anchored to public/audio/ itself, not public/audio/**, so it does not catch
# public/audio/effects/*.ogg — sound effects stay part of the build.
/public/audio/*.ogg
