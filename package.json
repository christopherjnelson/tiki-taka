{
  "name": "tiki-taka",
  "version": "0.4.6",
  "releaseStage": "alpha",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "description": "A single-player possession playground. No goals. All flow.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "perf:bundle": "npm run build && node scripts/perf-budget.mjs --check",
    "test:sw-contract": "npm run build && node --test tests/service-worker-contract.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:interface": "node tests/interface.browser.mjs",
    "test:one-touch": "node tests/one-touch.browser.mjs",
    "test:navigation": "node tests/navigation.browser.mjs",
    "test:desktop-account": "node tests/desktop-account.browser.mjs",
    "test:audio": "node tests/audio.browser.mjs",
    "test:perf": "npm run build && node tests/performance.browser.mjs",
    "test:web": "npm run test:browser && npm run test:interface && npm run test:navigation && npm run test:one-touch && npm run test:desktop-account && npm run test:audio",
    "test:mobile-layouts": "MOBILE_LAYOUTS=1 npm run test:browser && MOBILE_LAYOUTS=1 npm run test:interface && MOBILE_LAYOUTS=1 npm run test:navigation",
    "test:mobile-smoke": "node tests/mobile-smoke.browser.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "vite": "^8.2.2"
  }
}
