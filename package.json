{
  "name": "tiki-taka",
  "version": "1.1.1",
  "private": true,
  "main": "apps/electron/main.mjs",
  "desktopName": "tiki-taka.desktop",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "description": "A single-player possession playground. No goals. All flow.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:interface": "node tests/interface.browser.mjs",
    "test:one-touch": "node tests/one-touch.browser.mjs",
    "test:navigation": "node tests/navigation.browser.mjs",
    "test:mobile": "node tests/mobile.browser.mjs",
    "test:desktop-account": "node tests/desktop-account.browser.mjs",
    "test:audio": "node tests/audio.browser.mjs",
    "test:web": "npm run test:browser && npm run test:interface && npm run test:navigation && npm run test:one-touch && npm run test:mobile && npm run test:desktop-account && npm run test:audio",
    "test:mobile-freeze": "node scripts/check-mobile-freeze.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:pack": "node scripts/electron-pack.mjs",
    "test:electron": "node scripts/electron-test.mjs",
    "mobile:sync": "npm run build && cd apps/mobile && npx cap sync android",
    "mobile:android": "cd apps/mobile && npx cap open android",
    "mobile:build": "node scripts/android-build.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "^1.58.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1"
  }
}
